#!/usr/bin/env bash
# pre-commit hook for brenner-axiom/docs
# Validates Jekyll front matter, permalinks, and index.md coverage.
#
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or:      ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
EXIT_CODE=0
WARNINGS=0

# Colors (disabled if not a terminal)
if [ -t 1 ]; then
  RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'
else
  RED=''; YELLOW=''; GREEN=''; NC=''
fi

error() { echo -e "${RED}ERROR:${NC} $1"; EXIT_CODE=1; }
warn()  { echo -e "${YELLOW}WARN:${NC} $1"; WARNINGS=$((WARNINGS + 1)); }
ok()    { echo -e "${GREEN}OK:${NC} $1"; }

# Get staged .md files (Added/Modified)
STAGED_MD=$(git diff --cached --name-only --diff-filter=AM -- '*.md' | grep -v '^README.md$' || true)

if [ -z "$STAGED_MD" ]; then
  exit 0
fi

echo "🔍 Checking $(echo "$STAGED_MD" | wc -l) markdown file(s)..."
echo

# --- Check 1: Front matter exists ---
for f in $STAGED_MD; do
  filepath="$REPO_ROOT/$f"
  [ -f "$filepath" ] || continue

  # Skip files that are pure data (README files)
  case "$f" in
    */README.md|README.md) continue ;;
  esac

  # Check for YAML front matter
  if ! head -1 "$filepath" | grep -q '^---$'; then
    error "$f: Missing Jekyll front matter (must start with ---)"
    continue
  fi

  # Extract front matter
  FM=$(sed -n '1,/^---$/{ /^---$/d; p; }' "$filepath" | head -20)

  # Check required fields: layout and title
  if ! echo "$FM" | grep -q '^layout:'; then
    warn "$f: Missing 'layout' in front matter"
  fi
  if ! echo "$FM" | grep -q '^title:'; then
    warn "$f: Missing 'title' in front matter"
  fi

  # --- Check 2: Permalink must not start with /docs/ ---
  PERMALINK=$(echo "$FM" | grep '^permalink:' | sed 's/^permalink: *//' | tr -d '"'"'" || true)
  if [ -n "$PERMALINK" ]; then
    if echo "$PERMALINK" | grep -q '^/docs/'; then
      error "$f: Permalink '$PERMALINK' starts with /docs/ — baseurl already adds this. Use '${PERMALINK#/docs}' instead."
    fi
  fi
done

# --- Check 3: Index.md coverage ---
# Content directories that should have entries in index.md
CONTENT_DIRS="research dao ops pitch tutorials playbooks fleet"
INDEX_FILE="$REPO_ROOT/index.md"

if [ -f "$INDEX_FILE" ]; then
  INDEX_CONTENT=$(cat "$INDEX_FILE")

  for f in $STAGED_MD; do
    # Only check files in content directories
    DIR=$(echo "$f" | cut -d/ -f1)
    case " $CONTENT_DIRS " in
      *" $DIR "*) ;;
      *) continue ;;
    esac

    # Skip index/README files
    BASENAME=$(basename "$f")
    case "$BASENAME" in
      index.md|README.md) continue ;;
    esac

    # Derive the expected permalink or relative_url reference
    # Files are typically referenced by their permalink or path
    STEM="${f%.md}"

    # Check if referenced in index.md (by filename stem, permalink, or path)
    if ! echo "$INDEX_CONTENT" | grep -q "$STEM\|$(basename "$STEM")"; then
      warn "$f: Not referenced in index.md — add a link so it's discoverable on the homepage."
    fi
  done
fi

echo
if [ $EXIT_CODE -ne 0 ]; then
  echo -e "${RED}Pre-commit failed.${NC} Fix errors above before committing."
elif [ $WARNINGS -gt 0 ]; then
  echo -e "${YELLOW}$WARNINGS warning(s).${NC} Commit proceeding, but consider fixing."
else
  ok "All checks passed."
fi

exit $EXIT_CODE
